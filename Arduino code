#include <Servo.h>

// =====================================================
// SERVO OBJECTS
// =====================================================

Servo armA;
Servo armB;
Servo tailC;

Servo armD;
Servo armE;
Servo armF;


// =====================================================
// SERVO PINS
// =====================================================

const int pinD = 2;
const int pinE = 3;
const int pinF = 4;

const int pinTail = 9;

const int pinA = 10;
const int pinB = 11;
const int buzzerPin = 12;


// =====================================================
// SERVO ANGLES
// =====================================================

const int platformUp = 0;
const int platformDownDE = 85;
const int platformDownF = 90;

const int armDown = 65;
const int armTop = 130;
const int armStartPosition = 80;

const int tailClosed = 110;
const int tailOpen = 130;


// =====================================================
// CLASS VARIABLES
// =====================================================

int currentClass = 0;
int previousClass = 0;


// =====================================================
// MAIN ARM MOVEMENT
// =====================================================

int armPositionA = armStartPosition;
int armPositionB = armStartPosition;

int armTargetA = armStartPosition;
int armTargetB = armStartPosition;

unsigned long lastArmStepA = 0;
unsigned long lastArmStepB = 0;

const unsigned long armStepInterval = 100;
const unsigned long armWaveStepInterval = armStepInterval / 5;


// =====================================================
// TAIL CLAP VARIABLES
// =====================================================

int tailPosition = tailClosed;
int tailDirection = 1;

unsigned long lastTailMove = 0;
const unsigned long tailSpeed = 10;

int tailClapsCompleted = 0;
bool tailClapStarted = false;

bool class2PlatformRaised = false;


// =====================================================
// SETUP
// =====================================================

void setup() {
  Serial.begin(115200);

  armD.attach(pinD);
  armE.attach(pinE);
  armF.attach(pinF);

  tailC.attach(pinTail);

  armA.attach(pinA);
  armB.attach(pinB);

  armA.write(armPositionA);
  armB.write(armPositionB);

  Serial.println("Arduino ready - waiting for Processing.");
}


// =====================================================
// MAIN LOOP
// =====================================================

void loop() {
  // Processing sends raw class bytes: 1, 2, or 3
  while (Serial.available() > 0) {
    int incomingClass = Serial.read();

    if (incomingClass >= 1 && incomingClass <= 3) {
      currentClass = incomingClass;
    }
  }

  // Set class behavior only when the class changes
  if (currentClass != previousClass) {
    switch (currentClass) {
      case 1:
        armTargetA = armDown;
        armTargetB = armDown;

        armD.write(platformDownDE);
        armE.write(platformDownDE);
        armF.write(platformDownF);

        resetTailClaps();

        tone(buzzerPin, 2000);
        delay(130);
        noTone(buzzerPin);
        delay(35);

        tone(buzzerPin, 2300);
        delay(130);
        noTone(buzzerPin);
        delay(35);

        tone(buzzerPin, 2600);
        delay(130);
        noTone(buzzerPin);
        delay(35);

        tone(buzzerPin, 2300);
        delay(130);
        noTone(buzzerPin);
        delay(35);

        tone(buzzerPin, 2100);
        delay(130);
        noTone(buzzerPin);
        delay(35);

        tone(buzzerPin, 2400);
        delay(130);
        noTone(buzzerPin);
        delay(35);

        tone(buzzerPin, 2700);
        delay(180);
        noTone(buzzerPin);
        delay(220);

        Serial.println("COLOR: RED");
        Serial.println("CLASS: 1 | BEHAVIOR: BALANCE CENTER");
        break;

      case 2:
        armTargetA = armTop;
        armTargetB = armTop;
        class2PlatformRaised = false;

        // Keep D, E, and F down until A and B reach the top.
        armD.write(platformDownDE);
        armE.write(platformDownDE);
        armF.write(platformDownF);

        Serial.println("COLOR: GREEN");
        Serial.println("CLASS: 2 | BEHAVIOR: MOVE IN A CIRCLE");
        break;

      case 3:
        // Hold A where it is. B starts waving toward the opposite end.
        armTargetA = armPositionA;

        if (armPositionB <= (armDown + armTop) / 2) {
          armTargetB = armTop;
        } else {
          armTargetB = armDown;
        }

        armD.write(platformDownDE);
        armE.write(platformDownDE);
        armF.write(platformDownF);

        resetTailClaps();

        tone(buzzerPin, 2100);
        delay(100);
        noTone(buzzerPin);
        delay(30);

        tone(buzzerPin, 2500);
        delay(100);
        noTone(buzzerPin);
        delay(30);

        tone(buzzerPin, 2900);
        delay(100);
        noTone(buzzerPin);
        delay(30);

        tone(buzzerPin, 3300);
        delay(160);
        noTone(buzzerPin);
        delay(50);

        tone(buzzerPin, 2900);
        delay(100);
        noTone(buzzerPin);
        delay(30);

        tone(buzzerPin, 3300);
        delay(100);
        noTone(buzzerPin);
        delay(30);

        tone(buzzerPin, 3600);
        delay(180);
        noTone(buzzerPin);
        delay(80);

        tone(buzzerPin, 3000);
        delay(90);
        noTone(buzzerPin);
        delay(25);

        tone(buzzerPin, 3300);
        delay(90);
        noTone(buzzerPin);
        delay(25);

        tone(buzzerPin, 3600);
        delay(90);
        noTone(buzzerPin);
        delay(25);

        tone(buzzerPin, 3900);
        delay(350);
        noTone(buzzerPin);
        delay(400);

        Serial.println("COLOR: BLUE");
        Serial.println("CLASS: 3 | BEHAVIOR: BOUNCE");
        break;
    }

    previousClass = currentClass;
    delay (500);
  }

  moveArms();

  // Class 2 raises D and E and opens the tail after A and B reach 130°.
  if (currentClass == 2 &&
      armPositionA == armTop &&
      armPositionB == armTop &&
      !class2PlatformRaised) {
    armD.write(platformUp);
    armE.write(platformUp);
    tailC.write(tailOpen);
    class2PlatformRaised = true;

    tone(buzzerPin, 2900);
    delay(160);
    noTone(buzzerPin);
    delay(35);

    tone(buzzerPin, 2600);
    delay(160);
    noTone(buzzerPin);
    delay(35);

    tone(buzzerPin, 2300);
    delay(180);
    noTone(buzzerPin);
    delay(35);

    tone(buzzerPin, 2100);
    delay(250);
    noTone(buzzerPin);
    delay(120);

    tone(buzzerPin, 2500);
    delay(130);
    noTone(buzzerPin);
    delay(35);

    tone(buzzerPin, 2200);
    delay(150);
    noTone(buzzerPin);
    delay(35);

    tone(buzzerPin, 2000);
    delay(500);
    noTone(buzzerPin);
    delay(500);
  }

  // Keep the tail clapping while Class 1 or Class 3 is active.
  if (currentClass == 1 || currentClass == 3) {
    clapTail();
  }
}


// =====================================================
// ARM MOVEMENT
// =====================================================

void moveArms() {
  unsigned long currentTime = millis();

  // Move A at the normal slow speed toward its target.
  if (currentTime - lastArmStepA >= armStepInterval) {
    lastArmStepA = currentTime;

    if (armPositionA < armTargetA) {
      armPositionA++;
      armA.write(armPositionA);
    } else if (armPositionA > armTargetA) {
      armPositionA--;
      armA.write(armPositionA);
    }
  }

  // Move B at normal speed, except during Class 3.
  unsigned long bStepInterval = armStepInterval;

  if (currentClass == 3) {
    bStepInterval = armWaveStepInterval;
  }

  if (currentTime - lastArmStepB >= bStepInterval) {
    lastArmStepB = currentTime;

    if (armPositionB < armTargetB) {
      armPositionB++;
      armB.write(armPositionB);
    } else if (armPositionB > armTargetB) {
      armPositionB--;
      armB.write(armPositionB);
    }

    // Reverse B's direction at each end while Class 3 is active.
    if (currentClass == 3 && armPositionB == armTargetB) {
      if (armTargetB == armTop) {
        armTargetB = armDown;
      } else {
        armTargetB = armTop;
      }
    }
  }
}


// =====================================================
// TAIL CLAPPING
// =====================================================

void resetTailClaps() {
  tailClapsCompleted = 0;
  tailClapStarted = false;
}


void clapTail() {
  unsigned long currentTime = millis();

  // Begin each set of claps from the open position.
  if (!tailClapStarted) {
    tailPosition = tailOpen;
    tailDirection = -1;
    tailC.write(tailPosition);
    lastTailMove = currentTime;
    tailClapStarted = true;
  }

  // Stop after three open-to-closed movements.
  if (tailClapsCompleted >= 3) {
    return;
  }

  if (currentTime - lastTailMove >= tailSpeed) {
    lastTailMove = currentTime;
    tailPosition += 3 * tailDirection;

    if (tailDirection == -1 && tailPosition <= tailClosed) {
      tailPosition = tailClosed;
      tailClapsCompleted++;

      if (tailClapsCompleted < 3) {
        tailDirection = 1;
      }
    } else if (tailDirection == 1 && tailPosition >= tailOpen) {
      tailPosition = tailOpen;
      tailDirection = -1;
    }

    tailC.write(tailPosition);
  }
}
